# ── Bright Smile Dental – Voice Assistant ──────────────────────────────────────
# Copy this file to .env and adjust.  DO NOT commit .env.
# All variables here are non-secret configuration only.

# Clinic timezone (IANA name).  The demo crosses the Nov-1-2026 DST fall-back.
CLINIC_TZ=America/New_York

# Set to an ISO-8601 datetime to pin the assistant's clock (useful for demos).
# Leave blank to use the real system clock.
# Example: ASSISTANT_NOW=2026-10-26T14:00:00-04:00
ASSISTANT_NOW=

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Set to true to mount GET /api/demo/bookings (shows seeded fake names & codes).
DEMO_ENDPOINTS_ENABLED=true

# Set to true to include raw utterance text in server logs (off by default – PII).
LOG_UTTERANCES=false
